rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())))
      );
    }

    function canAccessMeeting(meetingId) {
      let meeting = get(/databases/$(database)/documents/meetings/$(meetingId)).data;
      return isSignedIn() && (
        isAdmin()
        || meeting.restrictToInvitees != true
        || request.auth.token.email.lower() in meeting.invitees
      );
    }

    // BEAM Grants Funding Capture System (3-tier model)
    // Admin identity determined by Firebase Token claims or existence in admin_users Firestore collection
    match /beamOpportunities/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /beamSubjects/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /beamPursuits/{pursuitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /activity/{eventId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // User-owned profile and onboarding data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cross-site website directory entries.
    match /beamWebsiteDirectory/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /useCases/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /nodes/{docId} {
      allow read: if resource.data.publiclyVisible == true || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /intake/{docId} {
      allow read, update, delete: if isSignedIn();
    }

    match /beamProcesses/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /workstationComments/{docId} {
      allow read: if canAccessMeeting(resource.data.meetingId);
      allow create: if canAccessMeeting(request.resource.data.meetingId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if canAccessMeeting(resource.data.meetingId)
        && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /workstationReviews/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /organizations/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /cohorts/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /participantProfiles/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /professionalProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == profileId
        && request.auth.uid == request.resource.data.participantUid;
      allow update, delete: if isSignedIn()
        && (request.auth.uid == resource.data.participantUid || isAdmin());
    }

    match /organizationMemberships/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /cohortMemberships/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /participantSourceAttribution/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /ragAllowlist/{docId} {
      allow get: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
